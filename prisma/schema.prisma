generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Пользователи. Пароль: passwordHash — bcrypt; null = вход не настроен (нужен для
// сид-демо или пока админ не задал). isAdmin — доступ к /admin/* и users API.
model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  avatarUrl        String?
  passwordHash     String?
  isAdmin          Boolean   @default(false)
  // эпоха сессий: JWT хранит эпоху выдачи; при смене пароля эпоха инкрементится
  // и все старые cookie (включая украденные) становятся невалидными
  sessionEpoch     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assignedTasks Task[]     @relation("TaskAssignee")
  comments      Comment[]  @relation("CommentAuthor")
  activities    Activity[] @relation("ActivityActor")
  apiTokens     ApiToken[]
}

// Персональный API-токен (MCP, скрипты). tokenHash — для auth; tokenEnc — шифрованный plain для повторного показа.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  tokenEnc   String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Project {
  id          String       @id @default(cuid())
  key         String       @unique // 2-5 латинских, uppercase
  name        String
  description String       @default("")
  color       String       @default("#64748b")
  icon        String?
  taskSeq     Int          @default(0) // счётчик для ключей задач
  // автодобавление новых задач на канвас графа (умолчание для галочки в модалке создания)
  autoGraph   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?
  statuses    Status[]
  tasks       Task[]
  graphNodes  GraphNode[]
  graphEdges  GraphEdge[]
  favorites   Favorite[]
  attachments Attachment[]
}

// Избранное — per user (ФТ-1.5)
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
}

// Статусы принадлежат проекту; category: 0 бэклог / 1 к работе / 2 в работе / 3 готово
model Status {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String
  category  Int
  order     Int
  tasks     Task[]

  @@index([projectId, order])
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      Int
  type        String // epic / story / task / bug
  title       String
  description String       @default("") // Markdown
  statusId    String
  status      Status       @relation(fields: [statusId], references: [id])
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  priority    String       @default("mid") // low / mid / high / crit
  dueDate     DateTime?
  labels      String       @default("[]") // JSON-массив строк
  parentId    String?
  parent      Task?        @relation("TaskTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Task[]       @relation("TaskTree")
  boardOrder  String       @default("a0") // дробный ключ позиции в канбане (п. 4.3)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String
  comments    Comment[]
  attachments Attachment[]
  linksFrom   Link[]       @relation("LinkFrom")
  linksTo     Link[]       @relation("LinkTo")
  activities  Activity[]

  @@unique([projectId, number]) // ключ задачи уникален в проекте (п. 4.2-1)
  @@index([projectId, statusId, boardOrder])
  @@index([projectId, parentId])
}

// Направленная связь: fromTaskId --(type)--> toTaskId (п. 4.1.2)
// blocks: from блокирует to. «Блокируется» — вычисляемая обратная выборка, не запись в БД.
model Link {
  id         String   @id @default(cuid())
  fromTaskId String
  fromTask   Task     @relation("LinkFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTaskId   String
  toTask     Task     @relation("LinkTo", fields: [toTaskId], references: [id], onDelete: Cascade)
  type       String // blocks / relates
  createdAt  DateTime @default(now())

  @@unique([fromTaskId, toTaskId, type])
  @@index([toTaskId, type])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("CommentAuthor", fields: [authorId], references: [id])
  body      String // Markdown
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
}

// taskId nullable: вложения, загруженные прямо на канвас графа, принадлежат проекту
model Attachment {
  id           String    @id @default(cuid())
  taskId       String?
  task         Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName     String
  size         Int
  mime         String
  storageKey   String
  previewKey   String?
  uploadedById String
  createdAt    DateTime  @default(now())

  @@index([taskId])
}

// Позиции для графа; сами данные живут в задачах/вложениях
model GraphNode {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  refType   String // task / attachment / note
  refId     String?
  x         Float    @default(0)
  y         Float    @default(0)
  text      String? // для note — Markdown
  w         Float?
  h         Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, refType, refId])
}

// История изменений — с MVP, задним числом не восстановишь (п. 4.1)
model Activity {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation("ActivityActor", fields: [actorId], references: [id])
  event     String // created / status_changed / field_changed / commented / file_added / linked / unlinked / deleted
  payload   String   @default("{}") // JSON: поле, старое, новое
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

// Свободные рёбра канваса: заметка/файл ↔ задача и т.п. — визуальные ассоциации
// без семантики blocks/relates (те живут в Link между задачами)
model GraphEdge {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromNodeId String
  toNodeId   String
  createdAt  DateTime @default(now())

  @@unique([fromNodeId, toNodeId])
  @@index([projectId])
}
